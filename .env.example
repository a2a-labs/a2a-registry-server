REGISTRY_HOST=0.0.0.0
REGISTRY_PORT=3003
REGISTRY_PUBLIC_URL=http://localhost:3003
REGISTRY_STORE=memory
REGISTRY_LOG_LEVEL=info
REGISTRY_DEFAULT_TTL_SECONDS=60
REGISTRY_MIN_TTL_SECONDS=10
REGISTRY_MAX_TTL_SECONDS=3600
REGISTRY_PRUNE_INTERVAL_MS=5000
REGISTRY_MAX_BODY_BYTES=1048576
REGISTRY_CORS_ORIGIN=*
